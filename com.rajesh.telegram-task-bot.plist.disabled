<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rajesh.telegram-task-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>/Users/rajeshcsharma/.hermes/telegram_task_bot.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/rajeshcsharma/.hermes/logs/telegram_bot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/rajeshcsharma/.hermes/logs/telegram_bot.err.log</string>
</dict>
</plist>